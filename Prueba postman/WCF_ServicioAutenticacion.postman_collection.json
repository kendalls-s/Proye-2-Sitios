{
  "info": {
    "name": "WCF - ServicioAutenticacion (Core4)",
    "description": "Pruebas del web service WCF de autenticacion (HU Core4).\n\nComo usar:\n1. Arranca tu WCF en Visual Studio (IIS Express). Debe quedar en http://localhost:62310.\n2. Si tu puerto es otro, cambia la variable baseUrl de la coleccion.\n3. Ejecuta '1. Ver WSDL' para confirmar que el servicio esta arriba.\n4. Ejecuta '2. Autenticar' con un usuario que exista en la BD.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:62310", "type": "string" },
    { "key": "usuario", "value": "admin", "type": "string" },
    { "key": "password", "value": "Admin123", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Ver WSDL (confirma que el servicio esta arriba)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/ServicioAutenticacion.svc?singleWsdl",
          "host": ["{{baseUrl}}"],
          "path": ["ServicioAutenticacion.svc"],
          "query": [{ "key": "singleWsdl", "value": null }]
        },
        "description": "Debe devolver un XML (el WSDL) con status 200. Si da error de conexion, el WCF no esta corriendo o el puerto es otro."
      }
    },
    {
      "name": "2. Autenticar (SOAP)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/xml; charset=utf-8" },
          { "key": "SOAPAction", "value": "\"http://tempuri.org/IServicioAutenticacion/Autenticar\"" }
        ],
        "body": {
          "mode": "raw",
          "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\"\n                  xmlns:tem=\"http://tempuri.org/\"\n                  xmlns:mod=\"http://schemas.datacontract.org/2004/07/AdministracionPersonal.WebService.Modelos\">\n   <soapenv:Header/>\n   <soapenv:Body>\n      <tem:Autenticar>\n         <tem:credenciales>\n            <mod:Usuario>{{usuario}}</mod:Usuario>\n            <mod:Password>{{password}}</mod:Password>\n         </tem:credenciales>\n      </tem:Autenticar>\n   </soapenv:Body>\n</soapenv:Envelope>",
          "options": { "raw": { "language": "xml" } }
        },
        "url": {
          "raw": "{{baseUrl}}/ServicioAutenticacion.svc",
          "host": ["{{baseUrl}}"],
          "path": ["ServicioAutenticacion.svc"]
        },
        "description": "Llama la operacion Autenticar. En la respuesta busca <Autenticado>true</Autenticado> y <NombreCompleto>. Si es false, revisa el <Mensaje>."
      }
    }
  ]
}
